<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.redbeardcodes</groupId>
        <artifactId>redbeardcodes-parent</artifactId>
        <version>1.0.0</version>
        <relativePath/>
    </parent>

    <artifactId>redbeardcodes-publishing-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>RedBeardCodes Publishing Parent</name>
    <description>Maven configuration for publishing RedBeardCodes projects.</description>
    <url>https://github.com/RedBeardCodes/redbeardcodes-publishing-parent</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>redbeardcodes</id>
            <name>Jeff Rogers</name>
            <email>redbeardcodes@gmail.com</email>
            <organization>RedBeardCodes</organization>
            <organizationUrl>https://github.com/RedBeardCodes</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/RedBeardCodes/redbeardcodes-publishing-parent.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/RedBeardCodes/redbeardcodes-publishing-parent.git</developerConnection>
        <url>https://github.com/RedBeardCodes/redbeardcodes-publishing-parent</url>
    </scm>

    <properties>
        <redbeardcodes.signing.fingerprint>75B4F31DA04DFC1962FBC7B85D4B4AD63312E6A2</redbeardcodes.signing.fingerprint>
    </properties>

    <profiles>
        <profile>
            <id>release</id>

            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <keyname>${redbeardcodes.signing.fingerprint}</keyname>
                                    <bestPractices>true</bestPractices>
                                    <ascDirectory>${project.build.directory}</ascDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>

